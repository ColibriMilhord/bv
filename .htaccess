# =============================================================================
# .htaccess — racine du site
# -----------------------------------------------------------------------------
# L'hébergement déploie le dépôt Git directement dans le dossier public. Tout
# ce qui est versionné se retrouve donc accessible par le web, y compris ce qui
# n'a jamais été destiné à l'être : l'historique Git, la documentation interne,
# les scripts de maintenance.
#
# Ce fichier ferme ces accès. Il s'applique à la racine et à tous les
# sous-dossiers ; le .htaccess de config/ reste en place, en second rideau.
#
# Rien ici ne modifie le fonctionnement du site : seules des adresses qui
# n'auraient jamais dû répondre cessent de répondre.
# =============================================================================

# ── Pas de listage de dossier ────────────────────────────────────────────────
# Sans cette ligne, un dossier sans page d'index affiche son contenu.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Migration de l'ancien site Wix bellevuedaveyron.com (2026-11-09) ─────
    # INERTES tant que le domaine .com pointe chez Wix : elles ne jouent que
    # pour une requête arrivée ICI avec un nom d'hôte en .com (www., en., es.).
    # Aujourd'hui ce sont les 301 posées chez Wix qui travaillent. Ces règles
    # prennent le relais le jour où le .com est rattaché à cet hébergement
    # (étape 2 de docs/migration-wix-com-vers-fr.md) : sans elles, couper Wix
    # ferait perdre d'un coup tout le référencement de l'ancien site.
    # GÉNÉRÉES depuis docs/wix/redirections-bellevuedaveyron-com.csv : ne pas
    # les retoucher à la main, modifier le CSV puis relancer
    # `python3 tools/generer-redirections-com.py`.
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^accueil/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^welcome/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^bienvenido/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^villa/?$ https://bellevuedaveyron.fr/#experience [R=301,NE,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^farmhouse/?$ https://bellevuedaveyron.fr/#experience [R=301,NE,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^granja/?$ https://bellevuedaveyron.fr/#experience [R=301,NE,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^le-parc/?$ https://bellevuedaveyron.fr/#experience [R=301,NE,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^thepark/?$ https://bellevuedaveyron.fr/#experience [R=301,NE,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^elparque/?$ https://bellevuedaveyron.fr/#experience [R=301,NE,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^contactez-nous/?$ https://bellevuedaveyron.fr/#reservation [R=301,NE,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^contact-us/?$ https://bellevuedaveyron.fr/#reservation [R=301,NE,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^contactenos/?$ https://bellevuedaveyron.fr/#reservation [R=301,NE,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^tarifs/?$ https://bellevuedaveyron.fr/#tarifs [R=301,NE,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^prices/?$ https://bellevuedaveyron.fr/#tarifs [R=301,NE,L]
