    RewriteRule ^post/vous-offrir-le-meilleur-confort-dans-notre-gîte-tel-est-notre-devise/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/blues-en-aveyron/?$ https://bellevuedaveyron.fr/decouvrir.php [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/locationgitederniereminute/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/les-nouveaux-transats-sont-arrivés/?$ https://bellevuedaveyron.fr/ [R=301,L]
