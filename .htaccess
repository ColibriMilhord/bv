    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^nosservices/?$ https://bellevuedaveyron.fr/#services [R=301,NE,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^ourservices/?$ https://bellevuedaveyron.fr/#services [R=301,NE,L]
