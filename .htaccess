    RewriteRule ^post/2015/02/23/participez-a-la-totem-box/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
