    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2015/04/09/et-voici-les-heureux-gagnants/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2015/11/06/musee-soulages-exposition-de-jesus-rafael-soto/?$ https://bellevuedaveyron.fr/decouvrir.php [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2015/10/05/marché-des-pays-de-laveyron-à-bercy/?$ https://bellevuedaveyron.fr/decouvrir.php [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2018/09/05/profitez-en-septembre-dune-piscine-chauff-c3-a9e-dans-le-g-c3-aete-5-c3-a9toiles-bellevu/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2015/05/25/tour-de-france-2015-en-aveyron/?$ https://bellevuedaveyron.fr/decouvrir.php [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2018/08/18/untitled/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2018/07/09/la-procession-st-epine-c3-80-st-eulalie-dolt/?$ https://bellevuedaveyron.fr/decouvrir.php [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2018/06/29/ce-weekend-cest-la-f-c3-aate-de-sainte-eulalie-dolt/?$ https://bellevuedaveyron.fr/decouvrir.php [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2018/07/15/france-2018-championne-du-monde/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2016/04/25/picasso-au-mus-c3-a9e-soulages-c3-a0-rodez-pr-c3-a8s-de-chez-nous/?$ https://bellevuedaveyron.fr/decouvrir.php [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2018/06/19/aujourdhui-assembl-c3-a9e-g-c3-a9n-c3-a9rale-de-lagence-du-d-c3-a9veloppement-du-tourisme/?$ https://bellevuedaveyron.fr/decouvrir.php [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2019/01/23/bonne-ann-c3-a9e/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2018/10/22/le-panier-daccueil-du-g-c3-aete-bellevue-daveyron/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/skiez-proche-de-bellevue-d-aveyron/?$ https://bellevuedaveyron.fr/decouvrir.php [R=301,L]
    # Toute autre adresse de l'ancien site (accueil compris) : accueil du .fr.
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^ https://bellevuedaveyron.fr/ [R=301,L]

    # www.bellevuedaveyron.fr → bellevuedaveyron.fr (sans toucher au reste).
    RewriteCond %{HTTP_HOST} ^www\.bellevuedaveyron\.fr$ [NC]
    RewriteRule ^(.*)$ https://bellevuedaveyron.fr/$1 [R=301,L]

    # ── Fichiers et dossiers cachés ──────────────────────────────────────────
    # .git en premier lieu : son contenu permet de reconstituer l'intégralité
    # du code et de son histoire, mots de passe d'alors compris. Également
    # .gitignore, .env, les fichiers d'éditeur.
    #
    # Exception : .well-known/, utilisé par les certificats TLS. Le bloquer
    # empêcherait leur renouvellement.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\. - [F,L]

    # ── Dossiers qui n'ont rien à faire sur le web ───────────────────────────
    #   docs/       documentation interne (dont le suivi de l'incident e-mail)
    #   tools/      scripts de maintenance
    #   partials/   fragments inclus côté serveur
    #   cache/      cache applicatif
    #   config/     configuration et secrets
    #
    # ARCHIVE/ et phpmailer/ ont été retirés du dépôt : ils contenaient le
    # seul appel à mail() du site, dans une vieille copie du formulaire. La
    # règle les vise toujours, au cas où une copie subsisterait sur le serveur
    # après une mise en production qui n'efface pas les fichiers disparus.
    RewriteRule ^(docs|tools|phpmailer|partials|cache|ARCHIVE|config)(/|$) - [F,L]
</IfModule>

# ── Extensions à ne jamais servir ────────────────────────────────────────────
# Documentation, exports de base, journaux, sauvegardes, scripts.
# robots.txt, sitemap.xml et llms.txt ne sont pas concernés : ils doivent
# rester lisibles.
<FilesMatch "\.(md|sql|log|bak|old|save|swp|swo|orig|rej|zip|tar|gz|tgz|yml|yaml|ini|sh|py|lock|dist|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── Fichier de configuration resté à la racine ───────────────────────────────
# config_datatourisme.php contient une clé d'accès au flux touristique. PHP ne
# la divulgue pas en s'exécutant, mais ce fichier n'a aucune raison de répondre
# à une requête directe. À terme, cette clé a sa place dans config/secrets.php.
<Files "config_datatourisme.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# ── En-têtes de sécurité ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Empêche le navigateur de deviner un type de fichier autre que celui
    # annoncé — la voie classique pour faire exécuter une image comme un script.
    Header always set X-Content-Type-Options "nosniff"

    # Interdit l'affichage du site dans un cadre sur un autre domaine, ce qui
    # permettrait de faire cliquer un visiteur à son insu.
    Header always set X-Frame-Options "SAMEORIGIN"

    # Le site référent n'est transmis qu'en HTTPS et sans le détail du chemin.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Aucune page n'a besoin de la caméra, du micro ni de la géolocalisation.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# =============================================================================
# FACULTATIF — adresse canonique
# -----------------------------------------------------------------------------
# Le site doit répondre à une seule adresse : https://bellevuedaveyron.fr.
# Servi aussi en « www », en « .com » ou en clair, il se fait concurrence à
# lui-même dans les moteurs de recherche.
#
# Les lignes ci-dessous redirigent tout vers l'adresse canonique. Elles sont
# volontairement désactivées : activez-les seulement après avoir vérifié que
# le domaine .fr répond bien, et que vous n'utilisez pas d'adresse de
# prévisualisation de l'hébergeur. Pour les activer, retirez le « # » devant
# les six lignes qui suivent.
#
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on [OR]
#     RewriteCond %{HTTP_HOST} !^bellevuedaveyron\.fr$ [NC]
#     RewriteRule ^(.*)$ https://bellevuedaveyron.fr/$1 [R=301,L]
# </IfModule>
# =============================================================================
