    RewriteRule ^post/2014/01/02/lhistoire-de-bellevue-daveyron/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2014/01/20/bellevue-daveyron-en-image/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2014/03/26/nouveaut-c3-a9s-2014/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
