    RewriteRule ^post/nettoyage-de-printemps/?$ https://bellevuedaveyron.fr/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^((www|en|es)\.)?bellevuedaveyron\.com$ [NC]
    RewriteRule ^post/2014/01/02/lhistoire-du-pays-de-bellevue-daveyron-g-c3-aete-5-c3-a9toiles-avec-piscine-chauff-c3-a9/?$ https://bellevuedaveyron.fr/ [R=301,L]
